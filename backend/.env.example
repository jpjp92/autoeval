# Backend Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Model Configuration
DEFAULT_MODEL=flashlite
DEFAULT_LANGUAGE=ko
DEFAULT_PROMPT_VERSION=v2
MAX_SAMPLES=100

# API Keys (if using external APIs)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Paths
OUTPUT_DIR=./output
VALIDATED_OUTPUT_DIR=./validated_output

# Feature Flags
ENABLE_STREAMING=true
ENABLE_EXPORT=true
ENABLE_EVALUATION=true

# PDF 추출 프로세스 수 (기본 1 = 순차). 2코어 이상 서버에서 2~4로 설정하면 표가 많은 PDF가 빨라진다.
# PDF_EXTRACT_WORKERS=1

# LLM 청킹 동시 호출 수 (없으면 50쪽 이하 8, 그 이상 10). Gemini 분당 요청 한도가 낮으면 줄인다.
# LLM_CHUNK_PARALLEL=8
